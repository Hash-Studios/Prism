    "Random favourite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Random favourite"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zufälliger Favorit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंदीदा में से कोई वॉलपेपर"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorito aleatorio"
          }
        }
      }
    },
    "No favourites yet. Open Prism and tap the heart on a wallpaper.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No favourites yet. Open Prism and tap the heart on a wallpaper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten. Öffne Prism und tippe bei einem Hintergrundbild auf das Herz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई पसंदीदा वॉलपेपर नहीं है। Prism खोलें और किसी वॉलपेपर पर दिल के निशान पर टैप करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes favoritos. Abre Prism y toca el corazón de un fondo de pantalla."
          }
        }
      }
    },
    "Could not load the Wall of the Day. Check your connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the Wall of the Day. Check your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hintergrundbild des Tages konnte nicht geladen werden. Prüfe deine Verbindung."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का वॉलपेपर लोड नहीं हो सका। अपना कनेक्शन जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el Fondo del día. Comprueba tu conexión."
          }
        }
      }
    },
    "Could not load your favourite wallpaper. Check your connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load your favourite wallpaper. Check your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lieblingshintergrundbild konnte nicht geladen werden. Prüfe deine Verbindung."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पसंदीदा वॉलपेपर लोड नहीं हो सका। अपना कनेक्शन जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar tu fondo de pantalla favorito. Comprueba tu conexión."
          }
        }
      }
    },
    "This wallpaper is in a format that Shortcuts cannot use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallpaper is in a format that Shortcuts cannot use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Hintergrundbild hat ein Format, das Kurzbefehle nicht verwenden können."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वॉलपेपर ऐसे फ़ॉर्मैट में है जिसका उपयोग Shortcuts नहीं कर सकता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fondo de pantalla tiene un formato incompatible con Atajos."
          }
        }
      }
    },
    "Get Prism Wallpaper": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Prism Wallpaper"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism-Hintergrundbild abrufen"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism वॉलपेपर पाएँ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener fondo de pantalla de Prism"
          }
        }
      }
    },
    "Gets a Prism wallpaper. Pass it to the Set Wallpaper action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets a Prism wallpaper. Pass it to the Set Wallpaper action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft ein Prism-Hintergrundbild ab. Übergib es an die Aktion „Hintergrundbild festlegen“."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism से वॉलपेपर पाएँ। इसे वॉलपेपर सेट करें ऐक्शन में दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene un fondo de pantalla de Prism. Pásalo a la acción Establecer fondo de pantalla."
          }
        }
      }
    },
    "Source": {
      "localizations": {
        "en": {
