<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PrismBaseWindowTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="PrismWindowTheme" parent="PrismBaseWindowTheme" />
    <style name="LaunchTheme" parent="PrismWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>
    <style name="NormalTheme" parent="PrismWindowTheme">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
