import 'package:Prism/core/analytics/providers/composite_analytics_provider.dart' as after_analytics;
import 'package:Prism/core/firestore/firestore_client.dart';
import 'package:Prism/core/firestore/firestore_query_specs.dart';
import 'package:Prism/core/utils/result.dart';
import 'package:Prism/features/favourite_walls/data/repositories/favourite_counts_repository_impl.dart'
    as after_favourites;
import 'package:Prism/features/user_blocks/domain/repositories/user_block_repository.dart';
import 'package:Prism/features/user_search/data/repositories/user_search_repository_impl.dart' as after_search;
