    "notif_push_wall_approved_for_artist_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallpaper is live! 🎉"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Hintergrundbild ist jetzt online! 🎉"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वॉलपेपर लाइव है! 🎉"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu fondo de pantalla ya está publicado! 🎉"
          }
        }
      }
    },
    "notif_push_wall_approved_for_artist_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" has been approved and is now visible to everyone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wurde freigegeben und ist jetzt für alle sichtbar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" मंज़ूर हो गया है और अब सभी को दिखाई दे रहा है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aprobó «%1$@» y ya está visible para todos."
          }
        }
      }
    },
