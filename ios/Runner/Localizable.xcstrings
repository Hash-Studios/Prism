    "Gets a Prism wallpaper. Pass it to the Set Wallpaper action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets a Prism wallpaper. Pass it to the Set Wallpaper action."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil wallpaper Prism. Teruskan ke tindakan Atur Wallpaper."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtém um papel de parede do Prism. Passe-o para a ação Definir Papel de Parede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft ein Prism-Hintergrundbild ab. Übergib es an die Aktion „Hintergrundbild festlegen“."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism से वॉलपेपर पाएँ। इसे वॉलपेपर सेट करें ऐक्शन में दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene un fondo de pantalla de Prism. Pásalo a la acción Establecer fondo de pantalla."
          }
        }
      }
    },
