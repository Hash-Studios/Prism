    "Wall of the Day": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall of the Day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundbild des Tages"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का वॉलपेपर"
          }
        },
