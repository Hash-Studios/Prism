<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wotd_widget_bg"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/streak_ring"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/streak_ring_track">

        <TextView
            android:id="@+id/streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/prism_widget_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
