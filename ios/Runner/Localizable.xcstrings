        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का वॉलपेपर आ गया है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya llegó el Fondo del día"
          }
        }
      }
    },
