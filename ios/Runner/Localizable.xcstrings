    },
    "notif_push_streak_reminder_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Prism now to keep your login streak alive 🔥"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne jetzt Prism, damit deine Anmeldeserie weiterläuft 🔥"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लॉगिन स्ट्रीक बनाए रखने के लिए अभी Prism खोलें 🔥"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Prism ahora para mantener tu racha de inicios de sesión 🔥"
          }
        }
      }
    },
    "notif_push_wotd_for_creator_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallpaper is the Wall of the Day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Hintergrundbild ist das Hintergrundbild des Tages"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वॉलपेपर आज का वॉलपेपर है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fondo de pantalla es el Fondo del día"
          }
        }
      }
    },
    "notif_push_wotd_for_creator_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism picked your wallpaper for everyone today. Thank you for sharing it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism hat dein Hintergrundbild heute für alle ausgewählt. Danke, dass du es geteilt hast."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism ने आज सभी के लिए आपका वॉलपेपर चुना है। इसे साझा करने के लिए धन्यवाद।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism eligió hoy tu fondo de pantalla para todos. Gracias por compartirlo."
          }
        }
      }
    },
    "notif_push_wotd_for_audience_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's Wall of the Day is here"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
