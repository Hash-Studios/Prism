    "notif_push_drop_last_call_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ends in %2$@ h. Wallpapers are unavailable for a month afterward."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berakhir dalam %2$@ jam. Setelah itu, wallpaper tidak tersedia selama sebulan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ termina em %2$@ h. Os papéis de parede ficarão indisponíveis por um mês depois disso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ endet in %2$@ Std. Danach sind die Hintergrundbilder einen Monat lang nicht verfügbar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ घंटे में समाप्त होगा। इसके बाद एक महीने तक वॉलपेपर उपलब्ध नहीं होंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ termina en %2$@ h. Después, los fondos no estarán disponibles durante un mes."
          }
        }
      }
    },
