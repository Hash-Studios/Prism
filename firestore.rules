rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_users/$(authEmail()));
    }

    function isConfiguredAdmin() {
      return isAdmin() || isAdminEmail();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasAuthEmail() {
      return isSignedIn() && request.auth.token.get('email', '') is string
          && request.auth.token.get('email', '') != '';
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function isEmailOwner(email) {
      return hasAuthEmail() && request.auth.token.email_verified == true
          && email is string && email == authEmail();
    }

    // pinnedAt is optional; when present it is the time the owner pinned the favourite.
    // favouriteWallToDoc stores string ids for every provider, including Pexels numeric ids.
    // Optional media/metadata fields vary by provider and by shipped client version.
    function validFavourite(docId) {
      let data = request.resource.data;
      return data.id is string && data.id == docId
          && data.provider is string
          && data.provider.lower() in ['prism', 'wall_of_the_day', 'walloftheday', 'wallhaven', 'pexels']
          && (!('pinnedAt' in data) || data.pinnedAt is timestamp);
    }

    // New profiles start empty: coins, premium and coinState are server-owned.
    function canCreateUserDoc(userId) {
      return isOwner(userId)
          && request.resource.data.id is string
          && request.resource.data.id == userId
          && (!('email' in request.resource.data)
              || (hasAuthEmail() && request.resource.data.email == authEmail())
              || (!hasAuthEmail() && request.resource.data.email == ''))
          // A candidate is not an identity. Only the server reservation transaction publishes the username.
          && request.resource.data.get('username', '') == ''
          && !('usernameLower' in request.resource.data)
          && ownerAppOpenValuesOk(request.resource.data)
          && request.resource.data.get('coins', 0) == 0
          && request.resource.data.get('premium', false) == false
          && request.resource.data.get('subscriptionTier', 'free') == 'free'
          && request.resource.data.get('followers', []).size() == 0
          && request.resource.data.get('badges', []).size() == 0
          && !('coinState' in request.resource.data)
          && !request.resource.data.keys().hasAny(['xp', 'xpWeek', 'cosmetics', 'quests', 'inventory', 'drops']);
    }

    // Owners may only touch the client-side coinState keys; award flags stay server-owned.
    function ownerCoinStateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coinState'])
          || request.resource.data.coinState.diff(resource.data.get('coinState', {})).affectedKeys().hasOnly([
            'premiumPreviewUnlocks', 'streakReminderEnabled', 'streakTimezoneOffsetMinutes', 'streakReminderNextAtUtc'
          ]);
    }

    // lastAppOpenAt is a server timestamp, so it matches request.time. A raw write can be at most
    // 5 minutes old, or 1 minute ahead, and the offset stays on the 15 minute grid.
    function ownerAppOpenTimestampOk(data) {
      return data.lastAppOpenAt is timestamp
          && data.lastAppOpenAt <= request.time + duration.value(1, 'm')
          && data.lastAppOpenAt >= request.time - duration.value(5, 'm');
    }

    function ownerAppOpenOffsetOk(data) {
      let offset = data.appOpenTimezoneOffsetMinutes;
      return offset is int && offset >= -720 && offset <= 840 && offset % 15 == 0;
    }

    function ownerAppOpenValuesOk(data) {
      let openAtOk = !('lastAppOpenAt' in data)
          || ownerAppOpenTimestampOk(data);
      let offsetOk = !('appOpenTimezoneOffsetMinutes' in data)
          || ownerAppOpenOffsetOk(data);
      return openAtOk && offsetOk;
    }

    function ownerAppOpenOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let timestampOk = !changed.hasAny(['lastAppOpenAt'])
          || ownerAppOpenTimestampOk(request.resource.data);
      let offsetOk = !changed.hasAny(['appOpenTimezoneOffsetMinutes'])
          || ownerAppOpenOffsetOk(request.resource.data);
      return timestampOk && offsetOk;
    }

    // Synced theme choice: all six keys, no extras. Light and dark each keep their own theme and accent.
    function validThemePrefs(p) {
      return p is map
        && p.keys().hasOnly(['mode', 'lightThemeId', 'lightAccent', 'darkThemeId', 'darkAccent', 'changedAt'])
        && p.keys().hasAll(['mode', 'lightThemeId', 'lightAccent', 'darkThemeId', 'darkAccent', 'changedAt'])
        && p.mode in ['light', 'dark', 'system']
        && p.lightThemeId is string && p.lightThemeId.size() > 0 && p.lightThemeId.size() <= 64
        && p.darkThemeId is string && p.darkThemeId.size() > 0 && p.darkThemeId.size() <= 64
        && p.lightAccent is int && p.lightAccent >= 0 && p.lightAccent <= 4294967295
        && p.darkAccent is int && p.darkAccent >= 0 && p.darkAccent <= 4294967295
        && p.changedAt is int && p.changedAt >= 0;
    }

    function ownerThemePrefsOk() {
      return !('themePrefs' in request.resource.data.diff(resource.data).affectedKeys())
        || validThemePrefs(request.resource.data.themePrefs);
    }

    function wallServerKeysAbsent() {
      return !request.resource.data.keys().hasAny(['creatorUid', 'dropReserved', 'dropWeek', 'boostedUntil', 'depth', 'spatial', 'originalProtected', 'originalObjectId', 'moderation', 'visionLabels', 'searchTerms', 'remixCount']);
    }

    function wallServerKeysUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorUid', 'dropReserved', 'dropWeek', 'boostedUntil', 'depth', 'spatial', 'originalProtected', 'originalObjectId', 'moderation', 'visionLabels', 'searchTerms', 'remixCount', 'remixOf', 'resubmitOf', 'challengeId']);
    }

    // Optional link to the wall this one remixes. The server removes a link it cannot verify.
    function validRemixOf() {
      return !('remixOf' in request.resource.data)
          || (request.resource.data.remixOf is string
              && request.resource.data.remixOf.matches('^[A-Za-z0-9_-]{1,64}$'));
    }

    function validResubmitOf() {
      return !('resubmitOf' in request.resource.data)
          || (request.resource.data.resubmitOf is string
              && request.resource.data.resubmitOf.size() <= 1024
              && request.resource.data.resubmitOf.matches('^[^/\\\\\\p{C}]+$')
              && !request.resource.data.resubmitOf.matches('^__.*')
              && request.resource.data.resubmitOf != '.'
              && request.resource.data.resubmitOf != '..');
    }

    function validChallengeId() {
      return !('challengeId' in request.resource.data)
          || (request.resource.data.challengeId is string
              && request.resource.data.challengeId.matches('^[A-Za-z0-9_-]{1,128}$'));
    }

    match /weeklyChallenges/{challengeId} {
      allow read: if true;
      allow write: if false;
      match /{privatePath=**} {
        allow read, write: if false;
      }
    }

    // Wall of the Day — public read, admin-only write (set via Cloud Function)
    match /wall_of_the_day/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Past Picks — public read, admin-only write (archived by Cloud Function)
    match /past_picks/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Legacy/ops config
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Public app metadata (icons, etc.)
    match /apps/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Public feeds; unreviewed docs are owner/admin only.
    match /walls/{docId} {
      // Reviewed walls stay readable while 3.7.0 clients are installed: they read unconverted walls and the original URL.
      // Tighten this to review == true && originalProtected == true && wallpaper_url == '' (and the four provenance
      // fields == '') once 3.7.0 share is low. 3.8.0 clients already filter to protected walls on their side.
      allow read: if resource.data.review == true || isEmailOwner(resource.data.email) || isConfiguredAdmin();
      // Admins re-create a rejected wall when they undo the rejection.
      allow create: if validChallengeId() && (isConfiguredAdmin()
          || (isSignedIn()
              && isEmailOwner(request.resource.data.email)
              && request.resource.data.review != true
              && wallServerKeysAbsent()
              && validRemixOf()
              && validResubmitOf()));
      // delete: request.resource is null — do not use request.resource.data here.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['challengeId'])
          && (isConfiguredAdmin()
          || (isEmailOwner(resource.data.email)
              && wallServerKeysUntouched()
              && request.resource.data.email == resource.data.email
              && resource.data.review != true
              && request.resource.data.review != true));
      allow delete: if isConfiguredAdmin()
          || (isEmailOwner(resource.data.email) && resource.data.review != true);
    }

    match /setups/{docId} {
      allow read: if resource.data.review == true || isEmailOwner(resource.data.email) || isConfiguredAdmin();
      allow create: if isSignedIn()
          && isEmailOwner(request.resource.data.email)
          && !('creatorUid' in request.resource.data)
          && request.resource.data.review != true;
      allow update: if isConfiguredAdmin()
          || (isEmailOwner(resource.data.email)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorUid'])
              && request.resource.data.email == resource.data.email
              && resource.data.review != true
              && request.resource.data.review != true);
      allow delete: if isConfiguredAdmin()
          || (isEmailOwner(resource.data.email) && resource.data.review != true);
    }

    // Drafts are private to their owner.
    match /draftSetups/{docId} {
      allow read: if isConfiguredAdmin() || isEmailOwner(resource.data.email);
      allow create: if isConfiguredAdmin() || isEmailOwner(request.resource.data.email);
      allow update: if isConfiguredAdmin()
          || (isEmailOwner(resource.data.email) && request.resource.data.email == resource.data.email);
      allow delete: if isConfiguredAdmin() || isEmailOwner(resource.data.email);
    }

    // Rejection archives are private to owner/admin.
    // The owner may delete a rejected item from their own list.
    match /rejectedWalls/{docId} {
      allow read: if isConfiguredAdmin() || isEmailOwner(resource.data.email);
      allow write: if isConfiguredAdmin();
      allow delete: if isEmailOwner(resource.data.email);
    }

    match /rejectedSetups/{docId} {
      allow read: if isConfiguredAdmin() || isEmailOwner(resource.data.email);
      allow write: if isConfiguredAdmin();
      allow delete: if isEmailOwner(resource.data.email);
    }

    // Legacy public content bucket.
    match /setupsv3/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Curated collections shown in feeds.
    match /collections/{docId} {
      allow read: if true;
      allow write: if isConfiguredAdmin();
    }

    // Private account state. Other users read the public projection in profiles/{uid}.
    match /usersv2/{userId} {
      allow read: if isOwner(userId) || isConfiguredAdmin();
      allow create: if canCreateUserDoc(userId) || isConfiguredAdmin();
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'profilePhoto', 'coverPhoto', 'bio', 'links', 'lastLoginAt', 'loggedIn',
            'interestCategories', 'onboardingV2', 'uploadsWeekStart',
            'uploadsThisWeek', 'id', 'createdAt', 'updatedAt', 'coinState',
            'lastAppOpenAt', 'appOpenTimezoneOffsetMinutes', 'themePrefs'
          ]) && ownerCoinStateOk() && ownerAppOpenOk() && ownerThemePrefsOk())
          || isConfiguredAdmin();
      allow delete: if isConfiguredAdmin();

      // Coin economy state (quests, inventory, unlocked drops, passes): owner read, server write.
      match /private/economy {
        allow read: if isOwner(userId) || isConfiguredAdmin();
        allow write: if false;
      }

      match /private/session {
        allow read, write: if isOwner(userId) || isConfiguredAdmin();
      }

      // Public folders this user follows. Written only by the setFolderFollow callable.
      match /followedFolders/{folderId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Block list: owner can read; writes only via Cloud Functions (Admin SDK).
      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Per-user favourites subcollections.
      match /images/{docId} {
        allow read, delete: if isOwner(userId) || isConfiguredAdmin();
        allow create, update: if (isOwner(userId) && validFavourite(docId)) || isConfiguredAdmin();
      }

      match /setups/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isConfiguredAdmin();
      }

      // Walls the user set or downloaded, so they come back on a new phone. The thumbnail is the only link:
      // no original URL, and no signed link. The client keeps at most 500 and deletes the oldest; deleteAccount
      // removes the rest.
      function validHistoryEntry(key) {
        let data = request.resource.data;
        return data.keys().hasOnly(['id', 'provider', 'thumb', 'action', 'at'])
            && data.keys().hasAll(['id', 'provider', 'thumb', 'action', 'at'])
            && data.id is string && data.id.size() > 0 && data.id.size() <= 128
            && data.provider in ['prism', 'wallhaven', 'pexels']
            && key == data.provider + '_' + data.id
            && data.thumb is string && data.thumb.size() <= 1024
            && data.thumb.matches('https://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*/[^#]*')
            && !data.thumb.matches('(?i).*[?&](signature|googleaccessid|sig|x-amz-[a-z0-9-]+|x-goog-[a-z0-9-]+)(=[^&#]*)?(&|#|$).*')
            && !data.thumb.matches('(?i).*[?&][^=&]*%[^=&]*=.*')
            && data.action in ['set', 'download']
            && data.at is timestamp;
      }

      function historyParentOpen(userId) {
        let parent = /databases/$(database)/documents/usersv2/$(userId);
        let deletionBarrier = /databases/$(database)/documents/creatorDeletionState/$(userId);
        return exists(parent)
            && get(parent).data.get('deleted', false) != true
            && (!exists(deletionBarrier) || get(deletionBarrier).data.get('closed', false) != true);
      }

      match /history/{key} {
        allow read, delete: if isOwner(userId) && historyParentOpen(userId);
        allow create, update: if isOwner(userId) && historyParentOpen(userId) && validHistoryEntry(key);
      }
    }

    // Private folders of saved walls. Only the owner reads or writes them; deleteAccount removes them.
    match /folders/{folderId} {
      function folderWritesOpen() {
        return !exists(/databases/$(database)/documents/creatorDeletionState/$(request.auth.uid))
            || get(/databases/$(database)/documents/creatorDeletionState/$(request.auth.uid)).data.get('closed', false) != true;
      }

      function validFolderName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50 && name == name.trim();
      }

      function validFolderFields(data) {
        return validFolderName(data.name)
            && data.itemCount is int && data.itemCount >= 0
            && data.covers is list && data.covers.size() <= 4
            && data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      // A folder item is a favourite doc plus ownerId and addedAt. Its id is "<provider lowercased>_<wall id>".
      function validFolderItem(itemKey) {
        let data = request.resource.data;
        return data.keys().hasOnly([
              'id', 'url', 'thumb', 'provider', 'category', 'views', 'resolution', 'fav', 'size',
              'photographer', 'collections', 'depth', 'spatial', 'createdAt', 'favouritedAt', 'ownerId', 'addedAt',
              'wallpaperDocumentId'
            ])
            && data.id is string && data.id.size() > 0
            && data.provider is string
            && data.provider.lower() in ['prism', 'wall_of_the_day', 'walloftheday', 'wallhaven', 'pexels']
            && itemKey == data.provider.lower() + '_' + data.id
            && (!('wallpaperDocumentId' in data)
                || (data.wallpaperDocumentId is string && data.wallpaperDocumentId.size() > 0))
            // The favourite mapper copies a Spatial Scene wall's {tier, map}.
            && (!('spatial' in data) || data.spatial is map)
            && data.ownerId == request.auth.uid
            && data.addedAt is timestamp;
      }

      allow read, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
          && folderWritesOpen()
          && request.resource.data.keys().hasOnly(['ownerId', 'name', 'createdAt', 'updatedAt', 'itemCount', 'covers'])
          && request.resource.data.ownerId == request.auth.uid
          && validFolderFields(request.resource.data);
      allow update: if isSignedIn()
          && folderWritesOpen()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt', 'itemCount', 'covers'])
          && validFolderFields(request.resource.data);

      // getAfter lets one batch create a folder with its first item.
      match /items/{itemKey} {
        function ownsFolder() {
          return get(/databases/$(database)/documents/folders/$(folderId)).data.ownerId == request.auth.uid;
        }

        // A deleted folder can leave items behind. Reusing its id must not expose the old owner's items.
        // Missing gets still support the Save sheet's membership check.
        allow get: if isSignedIn() && ownsFolder()
            && (!exists(/databases/$(database)/documents/folders/$(folderId)/items/$(itemKey))
                || resource.data.ownerId == request.auth.uid);
        allow list: if isSignedIn() && ownsFolder() && resource.data.ownerId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid
            && (!exists(/databases/$(database)/documents/folders/$(folderId)) || ownsFolder());
        allow create: if isSignedIn()
            && folderWritesOpen()
            && getAfter(/databases/$(database)/documents/folders/$(folderId)).data.ownerId == request.auth.uid
            && validFolderItem(itemKey);
        allow update: if isSignedIn()
            && folderWritesOpen()
            && resource.data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/folders/$(folderId)).data.ownerId == request.auth.uid
            && validFolderItem(itemKey);
      }
    }

    // Public folders: the server projection of a folder its owner made public (functions/src/publicFolders.ts).
    // Only the Admin SDK writes it. A block in either direction hides it, and items need a live header.
    match /publicFolders/{folderId} {
      function notBlocked(ownerId) {
        return !exists(/databases/$(database)/documents/usersv2/$(ownerId)/blockedUsers/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/usersv2/$(request.auth.uid)/blockedUsers/$(ownerId));
      }

      allow read: if isSignedIn() && notBlocked(resource.data.ownerId);
      allow write: if false;

      match /items/{itemKey} {
        allow read: if isSignedIn()
            && exists(/databases/$(database)/documents/publicFolders/$(folderId))
            && notBlocked(get(/databases/$(database)/documents/publicFolders/$(folderId)).data.ownerId);
        allow write: if false;
      }

      // Each user reads their own follows in usersv2/{uid}/followedFolders.
      match /followers/{followerUid} {
        allow read, write: if false;
      }
    }

    // Public profile documents contain only the server-projected profile allowlist.
    // Writes use the Admin SDK, which bypasses these client rules.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Legacy users collection.
    match /users/{userId} {
      allow read, write: if isConfiguredAdmin() || isOwner(userId);
    }

    // Notifications are readable by signed-in users; only admins/functions write.
    match /notifications/{docId} {
      allow read: if isSignedIn()
          && (hasAuthEmail() && resource.data.modifier == authEmail()
              || resource.data.modifier in ['all', 'premium', 'free']
              || resource.data.modifier == request.auth.uid
              || resource.data.modifier.matches('^[0-9]+([.][0-9]+)*$'));
      allow write: if isConfiguredAdmin();
    }

    // Admin-triggered notification queue.
    match /notificationRequests/{docId} {
      allow read, write: if isConfiguredAdmin();
    }

    // Referral/redeem codes. Admin-only: the Enter Code feature was removed client-side,
    // and any signed-in user could otherwise read every code in the collection.
    match /codes/{docId} {
      allow read, write: if isConfiguredAdmin();
    }

    // AI generation history is private per user.
    match /aiGenerations/{docId} {
      allow read: if isConfiguredAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isConfiguredAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isConfiguredAdmin() || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isConfiguredAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Coin transaction ledger is private per user.
    match /coinTransactions/{docId} {
      allow read: if isConfiguredAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Legacy token storage (if used, doc id should be UID).
    match /tokens/{userId} {
      allow read, write: if isConfiguredAdmin() || isOwner(userId);
    }

    // UGC reports (created via submitContentReport callable). Admin read/update for moderation UI.
    // Wall requests are written only by Cloud Functions; the app lists them through listWallRequests.
    match /wallRequests/{requestId} {
      // Docs hold uids; others see only the display name and avatar that listWallRequests returns.
      allow read: if (isSignedIn() && resource.data.requesterUid == request.auth.uid) || isConfiguredAdmin();
      allow write: if false;

      match /votes/{voterUid} {
        allow read: if isOwner(voterUid);
        allow write: if false;
      }
    }

    match /wallRequestRateDaily/{docId} {
      allow read, write: if false;
    }

    match /wallRequestVoteRateDaily/{docId} {
      allow read, write: if false;
    }

    match /contentReports/{docId} {
      allow read: if isConfiguredAdmin();
      allow create, delete: if false;
      allow update: if isConfiguredAdmin();
    }

    // Rate-limit state for content reports (Cloud Functions only).
    match /contentReportRateByTarget/{docId} {
      allow read, write: if false;
    }

    match /contentReportRateDaily/{docId} {
      allow read, write: if false;
    }

    // User block rate limits (Cloud Functions only).
    match /userBlockRateDaily/{docId} {
      allow read, write: if false;
    }

    match /userBlockRateByTarget/{docId} {
      allow read, write: if false;
    }

    // Public folder rate limits (Cloud Functions only).
    match /folderVisibilityRateDaily/{docId} {
      allow read, write: if false;
    }

    match /folderFollowRateDaily/{docId} {
      allow read, write: if false;
    }

    // Public view counters (writes via Cloud Functions Admin SDK only).
    match /wallpaper_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /setup_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Trending and popular wallpaper ids, written by the computeTrending function.
    match /trending/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /moods/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /popular/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Username registry (claimUsername callable). Signed-in users can read it.
    match /usernames/{name} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Daily push counts. Cloud Functions write them. Admins read the day rows.
    match /metrics/{docId} {
      allow read: if isConfiguredAdmin();
      allow write: if false;

      match /days/{dayId} {
        allow read: if isConfiguredAdmin();
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read, write: if false;
      }
    }

    // Coin economy v2. Config and drops are public, so guests see the live Drop. Boosts, draws and leaderboards are
    // read-only to signed-in users. questEventRate and giftRateDaily have no match: default deny.
    match /economyConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /drops/{weekKey} {
      allow read: if true;
      allow write: if false;
    }

    match /boosts/{wallId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /draws/{weekKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /drawTickets/{ticketId} {
      // The id is `{weekKey}_{uid}`, so the owner can read a ticket that does not exist yet.
      allow get: if isSignedIn() && ticketId == ticketId.split('_')[0] + '_' + request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /leaderboards/{weekKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
