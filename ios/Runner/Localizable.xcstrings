    "notif_push_streak_reminder_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your streak is about to break!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Serie droht abzubrechen!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी स्ट्रीक टूटने वाली है!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu racha está a punto de perderse!"
          }
        }
